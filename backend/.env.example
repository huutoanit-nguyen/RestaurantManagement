# Database configuration
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_URL=jdbc:mysql://localhost:3306/restaurant_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Server & HTTP
APP_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security & JWT
JWT_ISSUER=restaurant-app
JWT_PRIVATE_KEY_LOCATION=PrivateKey.pem
JWT_PUBLIC_KEY_LOCATION=publicKey.pem
